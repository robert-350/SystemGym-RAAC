# Copy to .env and adjust. Never commit .env.

# --- API ---
PORT=3000

# --- MySQL (used by docker-compose and, later, by the API config module) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gymflow
MYSQL_USER=gymflow
MYSQL_PASSWORD=change-me-dev-only
MYSQL_ROOT_PASSWORD=change-me-root-dev-only
